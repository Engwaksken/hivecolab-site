<?php

/**
 * Implements hook_schema().
 */
function hive_documents_schema() {
  $schema['hive_documents'] = array(
    'description' => 'Uploaded newsletter and report PDFs.',
    'fields' => array(
      'id' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'title' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE),
      'description' => array('type' => 'text', 'not null' => FALSE),
      'category' => array('type' => 'varchar', 'length' => 20, 'not null' => TRUE),
      'uri' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE),
      'filename' => array('type' => 'varchar', 'length' => 255, 'not null' => TRUE),
      'thumbnail_uri' => array('type' => 'varchar', 'length' => 255, 'not null' => FALSE),
      'year' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'publication_month' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE),
      'frequency' => array('type' => 'varchar', 'length' => 20, 'not null' => FALSE),
      'downloads' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'created' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE),
    ),
    'primary key' => array('id'),
    'indexes' => array('category' => array('category'), 'created' => array('created')),
  );
  return $schema;
}

/**
 * Add thumbnail and publication year fields to existing installations.
 */
function hive_documents_update_7001() {
  if (!db_field_exists('hive_documents', 'thumbnail_uri')) {
    db_add_field('hive_documents', 'thumbnail_uri', array(
      'type' => 'varchar', 'length' => 255, 'not null' => FALSE,
    ));
  }
  if (!db_field_exists('hive_documents', 'year')) {
    db_add_field('hive_documents', 'year', array(
      'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0,
    ));
    $documents = db_select('hive_documents', 'd')->fields('d', array('id', 'created'))->execute();
    foreach ($documents as $document) {
      db_update('hive_documents')->fields(array(
        'year' => (int) format_date($document->created, 'custom', 'Y'),
      ))->condition('id', $document->id)->execute();
    }
  }
  return t('Added document thumbnails and publication years.');
}

/**
 * Store newsletter/report publication frequency.
 */
function hive_documents_update_7002() {
  if (!db_field_exists('hive_documents', 'frequency')) {
    db_add_field('hive_documents', 'frequency', array(
      'type' => 'varchar', 'length' => 20, 'not null' => FALSE,
    ));
  }
  db_update('hive_documents')
    ->fields(array('frequency' => 'monthly'))
    ->condition('category', 'newsletter')
    ->execute();
  return t('Added document publication frequency. Existing newsletters are marked monthly.');
}

/**
 * Add an issue month for newsletters and backfill it from upload dates.
 */
function hive_documents_update_7003() {
  if (!db_field_exists('hive_documents', 'publication_month')) {
    db_add_field('hive_documents', 'publication_month', array(
      'type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE,
    ));
  }
  $newsletters = db_select('hive_documents', 'd')
    ->fields('d', array('id', 'created'))
    ->condition('category', 'newsletter')
    ->execute();
  foreach ($newsletters as $newsletter) {
    db_update('hive_documents')->fields(array(
      'publication_month' => (int) format_date($newsletter->created, 'custom', 'n'),
    ))->condition('id', $newsletter->id)->execute();
  }
  return t('Added issue months for newsletters. Existing issue months were inferred from upload dates.');
}

/**
 * Track the number of downloads for each document.
 */
function hive_documents_update_7004() {
  if (!db_field_exists('hive_documents', 'downloads')) {
    db_add_field('hive_documents', 'downloads', array(
      'type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0,
    ));
  }
  return t('Added document download counts.');
}

/**
 * Remove the orphaned Mailchimp segment action reported by Drupal.
 */
function hive_documents_update_7005() {
  if (!db_table_exists('actions')) {
    return t('The actions table does not exist; no orphaned action was removed.');
  }
  require_once DRUPAL_ROOT . '/includes/actions.inc';
  $action_ids = db_select('actions', 'a')
    ->fields('a', array('aid'))
    ->condition('callback', 'mailchimp_lists_add_to_segment_action')
    ->execute()
    ->fetchCol();
  foreach ($action_ids as $action_id) {
    actions_delete($action_id);
  }
  return t('Removed @count orphaned Mailchimp segment action(s).', array('@count' => count($action_ids)));
}
